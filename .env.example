NEXT_PUBLIC_RAZORPAY_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_IMAGE_URL=http://localhost:8000

# Laravel Reverb WebSocket configuration
NEXT_PUBLIC_REVERB_APP_KEY=
NEXT_PUBLIC_REVERB_HOST=localhost
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_SCHEME=http

# ---------------------------------------------------------------------------
# Product (E-commerce) integration — two INDEPENDENT bases
# ---------------------------------------------------------------------------
# Both are public build-time values (Next.js inlines NEXT_PUBLIC_* into the
# browser bundle). Never put an API key or the E-commerce internal service key
# here — that key lives only on the Workshop Backend.
#
# They may point at the same host in a given environment, but they are never
# derived from each other. Leave either blank to use the built-in default.

# Product API base: the Workshop Backend S2S proxy, including its /ecommerce
# segment. This is what keeps requests flowing Browser -> Workshop ->
# E-commerce, so do NOT point it at the E-commerce host directly.
#   default: {NEXT_PUBLIC_API_URL}/ecommerce
NEXT_PUBLIC_PRODUCT_API_BASE_URL=http://localhost:8000/api/v1/ecommerce

# Product media base: where product images are served from (shop public
# storage / CDN). Independent of the API host.
#   default: https://api.yogiandyathra.com/public
NEXT_PUBLIC_PRODUCT_MEDIA_BASE_URL=https://api.yogiandyathra.com/public
