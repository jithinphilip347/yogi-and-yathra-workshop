# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which is the documented source of truth for config.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Compiled stylesheet twins.
# The .scss sources are the single source of truth (DS-01/DS-02) and Next.js
# compiles them itself (with autoprefixer) at build time — nothing here needs a
# committed .css. Local editor tooling (a Sass watch/compile extension) writes
# these twins into src/assets/css on every .scss save, which is how they drifted
# from their sources in both directions before DS-01. Ignoring them means that
# local regeneration can never be committed again.
/src/assets/css/*.css
/src/assets/css/*.css.map
